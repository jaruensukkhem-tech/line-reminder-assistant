# ============================================================================
# LINE Official Account (Messaging API & LIFF)
# ============================================================================
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token"
LINE_CHANNEL_SECRET="your_line_channel_secret"
NEXT_PUBLIC_LIFF_ID="your_line_liff_id"
NEXT_PUBLIC_APP_URL="http://localhost:3050"
LINE_BOT_NAME="ชะโด"

# ============================================================================
# Google Gemini AI (AI Task Extraction / Function Calling)
# ============================================================================
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# ============================================================================
# Database (PostgreSQL / Supabase Cloud)
# ============================================================================
SUPABASE_URL="https://your_project_id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your_project_id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
DATABASE_URL="postgresql://postgres:password@localhost:5432/line_reminder_bot?schema=public"

# ============================================================================
# Cron Job Security (Push Notification Engine)
# ============================================================================
CRON_SECRET="your_cron_secret_token"
